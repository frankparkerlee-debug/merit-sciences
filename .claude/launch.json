{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "merit-render",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "merit-home-v2",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3014,
      "autoPort": true
    },
    {
      "name": "merit-supply",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "CHECKOUT_HOST=localhost next dev -p 3021"],
      "port": 3021,
      "autoPort": false
    },
    {
      "name": "merit-concepts",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "3030", "public"],
      "port": 3030,
      "autoPort": false
    }
  ]
}
